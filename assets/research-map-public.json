    {
      "id": "p59",
      "label": "Sex-chromosome expression in cancer cell lines",
      "type": "project",
      "summary": "In 27 of 49 Tahoe-100M lines, measured expression differed from the pattern expected from the recorded donor sex. The LINCS drug-response comparison was inconclusive.",
      "source_ids": [
        "p59_manuscript",
        "p59_supplement",
        "p59_states"
      ],
      "group": "Computational biology",
      "figure": {
        "src": "assets/research/fellowship-study-design.png",
        "source": "https://github.com/MateenahJAHAN/Project-59-CMAP-Sex-Differences/blob/main/manuscript/figures/fig1_design.pdf",
        "caption": "Study design",
        "alt": "Two workflows: compare vehicle-cell Y-gene and XIST expression with donor labels and other assays, and use bulk RNA sequencing to compare LINCS2020 drug responses within lineage.",
        "width": 1950,
        "height": 732
      }
    },
    {
      "id": "csir_tcr",
